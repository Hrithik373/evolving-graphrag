# evolving-graphrag configuration. Copy to .env and edit.
# Every value here is read by pydantic-settings (src/egraph/settings.py). Nothing in the
# codebase is hard-coded, and `config_hash` in an eval run is derived from this whole set.

# --- backends ------------------------------------------------------------------------
# memory   = in-process (tests, laptop demo, eval)
# postgres = the deployable backend; free and managed on Neon, Supabase, Render, Railway
# arcadedb = the graph-native store used by the Compose stack
EGRAPH_STORE_BACKEND=memory
# Most providers hand you this as DATABASE_URL.
EGRAPH_POSTGRES_DSN=postgresql://egraph:egraph@localhost:5432/egraph
EGRAPH_POSTGRES_POOL_MAX=8
EGRAPH_ARCADEDB_URL=http://localhost:2480
EGRAPH_ARCADEDB_DATABASE=egraph
EGRAPH_ARCADEDB_USER=root
EGRAPH_ARCADEDB_PASSWORD=playwithdata
POSTGRES_USER=egraph
POSTGRES_PASSWORD=egraph
POSTGRES_DB=egraph
# Snapshot path for the memory store; empty means never touch disk.
EGRAPH_MEMORY_STORE_PATH=./data/graph_store.json

# inline = run jobs in-process (no Redis). arq = real workers.
EGRAPH_QUEUE_BACKEND=inline
EGRAPH_REDIS_URL=redis://localhost:6379
EGRAPH_REDIS_QUEUE_NAME=egraph:jobs

# --- models --------------------------------------------------------------------------
# mock      = deterministic offline extractor/summariser. No API key, runs in CI.
# anthropic = the official SDK. Needs ANTHROPIC_API_KEY (or an `ant auth login` profile).
# gateway   = your own FastAPI proxy at EGRAPH_GATEWAY_URL, POST /v1/complete.
EGRAPH_LLM_BACKEND=mock
EGRAPH_LLM_MODEL=claude-opus-5
EGRAPH_LLM_MAX_TOKENS=1024
EGRAPH_LLM_EFFORT_EXTRACT=low
EGRAPH_LLM_EFFORT_SUMMARIZE=medium
EGRAPH_GATEWAY_URL=http://localhost:8080
EGRAPH_GATEWAY_API_KEY=
# Secrets live only in the environment, never in the repo.
ANTHROPIC_API_KEY=

# USD per 1M tokens - used by CostMeter to price every call. Defaults are claude-opus-5.
EGRAPH_PRICE_IN_PER_MTOK=5.0
EGRAPH_PRICE_OUT_PER_MTOK=25.0

# hash = deterministic offline embedder (no download). Set sentence-transformers for
# semantic quality; embed_dim is then taken from the model.
EGRAPH_EMBED_BACKEND=hash
EGRAPH_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EGRAPH_EMBED_DIM=256

# --- ingest --------------------------------------------------------------------------
EGRAPH_CHUNK_SIZE=400
# Overlap defaults to 0: overlapping chunks copy their predecessor's tail, so editing one
# paragraph changes the content-addressed id of the next chunk and destroys chunk reuse.
EGRAPH_CHUNK_OVERLAP=0

# --- entity resolution ----------------------------------------------------------------
# A merge needs BOTH thresholds. The eval sweeps tau_sim.
EGRAPH_TAU_SIM=0.86
EGRAPH_TAU_NAME=0.90

# --- maintenance ------------------------------------------------------------------------
# How many dirty community summaries a worker regenerates per tick. This is the knob the
# cost-vs-freshness Pareto curve sweeps.
EGRAPH_DIRTY_BATCH_SIZE=8
EGRAPH_COMPACTION_ENABLED=true
EGRAPH_COMPACTION_INTERVAL_S=900
EGRAPH_MAX_COMMUNITY_SIZE=8
EGRAPH_CLUSTER_BACKEND=auto

# --- retrieval ---------------------------------------------------------------------------
EGRAPH_TOP_K_ENTITIES=8
EGRAPH_TOP_K_COMMUNITIES=3
EGRAPH_MAX_CONTEXT_CHARS=6000

# --- api / ops -----------------------------------------------------------------------------
EGRAPH_API_PORT=8000
EGRAPH_METRICS_ENABLED=true
EGRAPH_SEED=1337
# Load the bundled mini-corpus on boot, but only into an index that is empty. Used by the
# public demo so the URL does not open on a blank graph; never overwrites uploads.
EGRAPH_SEED_ON_START=false
EGRAPH_EVAL_OUTPUT_DIR=./results

# --- docker compose only --------------------------------------------------------------------
ARCADEDB_PASSWORD=playwithdata
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
WORKER_MAX_JOBS=10
